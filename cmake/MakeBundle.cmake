# cmake -DEXE=<executable> -DAPP=<out>/Zoosters.app [-DSDL3_LIB=<libSDL3 dylib>] -DPLIST_IN=<Info.plist.in> -DSOURCE_DIR=<repo>
#       [-DGIT=<git>] -P MakeBundle.cmake
# Assembles the macOS application bundle from the linked executable: Contents/MacOS/zoosters, SDL3 and OpenAL Soft in
# Contents/Frameworks (found through @executable_path/../Frameworks), the files next to the executable (Mod/, gamecontrollerdb) in
# Contents/Resources (SDL_GetBasePath), the icon (res/zoosters.icns), Info.plist, an ad-hoc signature (install_name_tool invalidates the linker's; arm64 runs
# nothing unsigned).
get_filename_component(exe_dir "${EXE}" DIRECTORY)
file(REMOVE_RECURSE "${APP}")
set(macos "${APP}/Contents/MacOS")
set(fw "${APP}/Contents/Frameworks")
set(res "${APP}/Contents/Resources")
file(MAKE_DIRECTORY "${macos}" "${fw}" "${res}")
set(bin "${macos}/zoosters")
file(COPY_FILE "${EXE}" "${bin}")

set(libs)
if(SDL3_LIB)
  file(REAL_PATH "${SDL3_LIB}" sdl_real)
  file(COPY_FILE "${sdl_real}" "${fw}/libSDL3.0.dylib")
  list(APPEND libs libSDL3.0.dylib)
endif()
if(EXISTS "${exe_dir}/libopenal.dylib")
  file(REAL_PATH "${exe_dir}/libopenal.dylib" al_real)
  file(COPY_FILE "${al_real}" "${fw}/libopenal.dylib")
  list(APPEND libs libopenal.dylib)
endif()
foreach(l ${libs})
  file(CHMOD "${fw}/${l}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
  execute_process(COMMAND install_name_tool -id "@rpath/${l}" "${fw}/${l}" COMMAND_ERROR_IS_FATAL ANY)
endforeach()

execute_process(COMMAND otool -L "${bin}" OUTPUT_VARIABLE linked)
string(REPLACE "\n" ";" linked "${linked}")
foreach(line ${linked})
  if(line MATCHES "^[ \t]+([^ ]*libSDL3[^ ]*) ")
    execute_process(COMMAND install_name_tool -change "${CMAKE_MATCH_1}" "@rpath/libSDL3.0.dylib" "${bin}" COMMAND_ERROR_IS_FATAL ANY)
  endif()
endforeach()
execute_process(COMMAND otool -l "${bin}" OUTPUT_VARIABLE loads)
string(REGEX MATCHALL "path [^\n]* \\(offset" rpaths "${loads}")
foreach(r ${rpaths})
  string(REGEX REPLACE "^path (.*) \\(offset$" "\\1" r "${r}")
  execute_process(COMMAND install_name_tool -delete_rpath "${r}" "${bin}")
endforeach()
execute_process(COMMAND install_name_tool -add_rpath "@executable_path/../Frameworks" "${bin}" COMMAND_ERROR_IS_FATAL ANY)

if(IS_DIRECTORY "${exe_dir}/Mod")
  file(COPY "${exe_dir}/Mod" DESTINATION "${res}")
endif()
foreach(f gamecontrollerdb.txt gamecontrollerdb_LICENSE.txt)
  if(EXISTS "${exe_dir}/${f}")
    file(COPY_FILE "${exe_dir}/${f}" "${res}/${f}")
  endif()
endforeach()

file(COPY_FILE "${SOURCE_DIR}/res/zoosters.icns" "${res}/zoosters.icns")

set(ZOOSTERS_REVISION 0)
if(GIT)
  execute_process(COMMAND "${GIT}" rev-parse --short HEAD WORKING_DIRECTORY "${SOURCE_DIR}" OUTPUT_VARIABLE rev
                  OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
  if(rc EQUAL 0 AND rev)
    set(ZOOSTERS_REVISION "${rev}")
  endif()
endif()
configure_file("${PLIST_IN}" "${APP}/Contents/Info.plist" @ONLY)
execute_process(COMMAND codesign --force --deep --sign - "${APP}" RESULT_VARIABLE rc OUTPUT_QUIET ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "codesign failed: ${err}")
endif()
