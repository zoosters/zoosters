# Build options. A tier decides which deviations from the original game are compiled in; renderer, window and OS backends pick
# the platform layer; the debug UI and the development harness are separate flavours that combine with any tier.

set(ZOOSTERS_TIER "qol" CACHE STRING "Feature tier: vanilla (the original 1:1), fixes (+ bug fixes), qol (+ widescreen, in-game options)")
set_property(CACHE ZOOSTERS_TIER PROPERTY STRINGS vanilla fixes qol)
set(_tiers vanilla fixes qol)
list(FIND _tiers "${ZOOSTERS_TIER}" ZOOSTERS_TIER_INDEX)
if(ZOOSTERS_TIER_INDEX LESS 0)
  message(FATAL_ERROR "ZOOSTERS_TIER must be vanilla, fixes or qol (got '${ZOOSTERS_TIER}')")
endif()

option(ZOOSTERS_BINK "Play the game's movies (Bink 1 decoder in src/port/bink); OFF: movies are skipped" ON)
option(ZOOSTERS_BINK_LOGOS "With ZOOSTERS_BINK: also the four startup logo movies (52 s) at every start, as the original" OFF)
option(ZOOSTERS_DEBUGUI "Dear ImGui debug overlay (F1 in the game); never part of a release build" OFF)
option(ZOOSTERS_DEV_HARNESS "Development harness (src/dev): game-address map, golden / semantic traces, draw capture" OFF)
option(ZOOSTERS_CALLTRACE "Call-trace build (needs ZOOSTERS_DEV_HARNESS; Windows only)" OFF)
option(ZOOSTERS_OS_POISON "Every Windows header is an #error (src/dev/poison first on the include path)" OFF)

if(WIN32)
  set(_os_default win32)
  set(_platform_default d3d9)
else()
  set(_os_default sdl)
  set(_platform_default gl3)
endif()
set(ZOOSTERS_OS "${_os_default}" CACHE STRING "OS layer: win32 (Windows API, the game's own calls) or sdl (SDL3 + the C++ standard library)")
set_property(CACHE ZOOSTERS_OS PROPERTY STRINGS win32 sdl)
set(ZOOSTERS_PLATFORM "${_platform_default}" CACHE STRING "Renderer: d3d9 (Direct3D 9, Windows), gl3 (OpenGL 3.3 on SDL3) or null (headless)")
set_property(CACHE ZOOSTERS_PLATFORM PROPERTY STRINGS d3d9 gl3 null)
set(ZOOSTERS_WINDOW "" CACHE STRING "Window / input backend: win32 or sdl (empty: sdl with gl3, else win32)")
set_property(CACHE ZOOSTERS_WINDOW PROPERTY STRINGS "" win32 sdl)
set(ZOOSTERS_SETTINGS "" CACHE STRING "Settings store: registry (Windows, as the game) or file (settings.ini; empty: file for qol or the sdl OS layer)")
set_property(CACHE ZOOSTERS_SETTINGS PROPERTY STRINGS "" registry file)

if(ZOOSTERS_OS STREQUAL "sdl")
  if(ZOOSTERS_PLATFORM STREQUAL "d3d9" OR ZOOSTERS_WINDOW STREQUAL "win32" OR ZOOSTERS_SETTINGS STREQUAL "registry")
    message(FATAL_ERROR "ZOOSTERS_OS=sdl implies ZOOSTERS_PLATFORM=gl3, ZOOSTERS_WINDOW=sdl, ZOOSTERS_SETTINGS=file")
  endif()
  set(ZOOSTERS_PLATFORM gl3)
  set(ZOOSTERS_WINDOW sdl)
  set(ZOOSTERS_SETTINGS file)
elseif(NOT WIN32)
  message(FATAL_ERROR "ZOOSTERS_OS=win32 is the Windows build; use ZOOSTERS_OS=sdl")
endif()
if(NOT ZOOSTERS_WINDOW)
  if(ZOOSTERS_PLATFORM STREQUAL "gl3")
    set(ZOOSTERS_WINDOW sdl)
  else()
    set(ZOOSTERS_WINDOW win32)
  endif()
endif()
if(ZOOSTERS_PLATFORM STREQUAL "gl3" AND NOT ZOOSTERS_WINDOW STREQUAL "sdl")
  message(FATAL_ERROR "ZOOSTERS_PLATFORM=gl3 needs ZOOSTERS_WINDOW=sdl (librw gl3 runs on SDL3)")
endif()
if(ZOOSTERS_PLATFORM STREQUAL "null" AND NOT ZOOSTERS_WINDOW STREQUAL "win32")
  message(FATAL_ERROR "ZOOSTERS_PLATFORM=null is headless: no SDL window")
endif()
if(ZOOSTERS_TIER_INDEX GREATER_EQUAL 2)
  # qol keeps its settings in settings.ini: a port build never writes the original game's registry
  if(ZOOSTERS_SETTINGS STREQUAL "registry")
    message(FATAL_ERROR "ZOOSTERS_TIER=qol keeps its settings in settings.ini; ZOOSTERS_SETTINGS=registry is for vanilla / fixes")
  endif()
  set(ZOOSTERS_SETTINGS file)
endif()
if(NOT ZOOSTERS_SETTINGS)
  set(ZOOSTERS_SETTINGS registry)
endif()
if(ZOOSTERS_DEBUGUI AND ZOOSTERS_PLATFORM STREQUAL "null")
  message(FATAL_ERROR "ZOOSTERS_DEBUGUI needs a window: ZOOSTERS_PLATFORM d3d9 or gl3")
endif()
if(ZOOSTERS_CALLTRACE)
  if(NOT ZOOSTERS_DEV_HARNESS)
    message(FATAL_ERROR "ZOOSTERS_CALLTRACE needs ZOOSTERS_DEV_HARNESS=ON")
  endif()
  if(NOT WIN32)
    message(FATAL_ERROR "ZOOSTERS_CALLTRACE: Windows builds only")
  endif()
endif()

set(ZOOSTERS_LIBRW_DIR "${CMAKE_CURRENT_SOURCE_DIR}/vendor/librw" CACHE PATH "librw source tree (branch with the Zoosters changes)")
set(ZOOSTERS_IMGUI_DIR "${ZOOSTERS_LIBRW_DIR}/skeleton/imgui" CACHE PATH "Dear ImGui sources (librw ships them in skeleton/imgui)")
set(ZOOSTERS_DXSDK_DIR "" CACHE PATH "Optional DirectX SDK (June 2010) for d3d9.h / d3d9.lib; empty: the Windows SDK's")
set(ZOOSTERS_GAMECONTROLLERDB_DIR "" CACHE PATH "Optional SDL_GameControllerDB checkout (gamecontrollerdb.txt), copied next to the executable")
set(ZOOSTERS_MODSTREAM_TOOL "" CACHE FILEPATH "Optional texture packer that builds Mod/Levels/options.stream for the qol tier")

message(STATUS "Zoosters: tier ${ZOOSTERS_TIER}, os ${ZOOSTERS_OS}, platform ${ZOOSTERS_PLATFORM}, window ${ZOOSTERS_WINDOW}, "
               "settings ${ZOOSTERS_SETTINGS}, movies ${ZOOSTERS_BINK}, debugui ${ZOOSTERS_DEBUGUI}, dev harness ${ZOOSTERS_DEV_HARNESS}")
