# Third-party dependencies: SDL3 (window, input, OS layer; linked) and OpenAL Soft (sound; never linked, loaded at run time from
# next to the executable, so it is only located here to be copied there). An installed package is used when found, else the
# release is fetched and built.
include(FetchContent)

set(ZOOSTERS_SDL3_TAG "release-3.4.18" CACHE STRING "SDL3 release fetched when no installed SDL3 is found")
set(ZOOSTERS_OPENAL_TAG "1.25.2" CACHE STRING "OpenAL Soft release fetched when no installed OpenAL Soft is found")

set(ZOOSTERS_NEEDS_SDL3 OFF)
if(ZOOSTERS_WINDOW STREQUAL "sdl" OR ZOOSTERS_OS STREQUAL "sdl")
  set(ZOOSTERS_NEEDS_SDL3 ON)
endif()

if(ZOOSTERS_NEEDS_SDL3)
  find_package(SDL3 CONFIG COMPONENTS SDL3-shared QUIET)
  if(SDL3_FOUND)
    message(STATUS "SDL3: ${SDL3_VERSION} (${SDL3_DIR})")
  else()
    message(STATUS "SDL3: not installed, fetching ${ZOOSTERS_SDL3_TAG}")
    set(SDL_SHARED ON CACHE BOOL "" FORCE)
    set(SDL_STATIC OFF CACHE BOOL "" FORCE)
    set(SDL_TEST_LIBRARY OFF CACHE BOOL "" FORCE)
    FetchContent_Declare(SDL3 GIT_REPOSITORY https://github.com/libsdl-org/SDL.git GIT_TAG ${ZOOSTERS_SDL3_TAG} GIT_SHALLOW TRUE)
    FetchContent_MakeAvailable(SDL3)
  endif()
endif()

# OpenAL Soft: CONFIG mode only (CMake's FindOpenAL would take Apple's deprecated OpenAL.framework, which the port does not load).
find_package(OpenAL CONFIG QUIET)
if(OpenAL_FOUND AND TARGET OpenAL::OpenAL)
  message(STATUS "OpenAL Soft: ${OpenAL_DIR}")
  set(ZOOSTERS_OPENAL_TARGET OpenAL::OpenAL)
else()
  option(ZOOSTERS_FETCH_OPENAL "Fetch and build OpenAL Soft when it is not installed (else the port runs silent)" ON)
  if(ZOOSTERS_FETCH_OPENAL)
    message(STATUS "OpenAL Soft: not installed, fetching ${ZOOSTERS_OPENAL_TAG}")
    set(LIBTYPE SHARED CACHE STRING "" FORCE)
    set(ALSOFT_UTILS OFF CACHE BOOL "" FORCE)
    set(ALSOFT_EXAMPLES OFF CACHE BOOL "" FORCE)
    set(ALSOFT_TESTS OFF CACHE BOOL "" FORCE)
    set(ALSOFT_INSTALL OFF CACHE BOOL "" FORCE)
    FetchContent_Declare(openal-soft GIT_REPOSITORY https://github.com/kcat/openal-soft.git GIT_TAG ${ZOOSTERS_OPENAL_TAG} GIT_SHALLOW TRUE)
    FetchContent_MakeAvailable(openal-soft)
    # its -Werror=function-effects trips on newer Apple clang (coreaudio.cpp)
    include(CheckCXXCompilerFlag)
    check_cxx_compiler_flag(-Wno-error=function-effects ZOOSTERS_HAS_WFUNCTION_EFFECTS)
    if(ZOOSTERS_HAS_WFUNCTION_EFFECTS)
      target_compile_options(OpenAL PRIVATE -Wno-error=function-effects)
    endif()
    set(ZOOSTERS_OPENAL_TARGET OpenAL)
  else()
    message(STATUS "OpenAL Soft: not found; the port runs silent")
    set(ZOOSTERS_OPENAL_TARGET "")
  endif()
endif()
