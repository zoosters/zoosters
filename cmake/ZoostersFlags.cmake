# Compiler and linker flags. The game code relies on MSVC code-generation rules; with clang they are spelled out:
#   -fno-strict-aliasing      the game reads one object through several types
#   -fwrapv                   signed arithmetic wraps
#   -fno-delete-null-pointer-checks   null checks the game makes stay
#   -fno-threadsafe-statics / /Zc:threadSafeInit-   MSVC 7.1 local-static semantics: the game re-enters statics while they
#                             initialise (TFBType_Value -> RegisterValueOps), which a guarded static turns into a deadlock
# and off Windows (arm64, POSIX) what MSVC and x86-64 do implicitly:
#   -ffp-contract=off         no FMA contraction: x64 SSE2 code never fuses a*b+c, a fused result drifts from the Windows builds
#   -fsigned-char             char is signed (unsigned by default on Linux / Android arm64)
#   -fdeclspec -fms-extensions   __declspec and the MS keywords
# Optimisation is fixed at -O2 / /O2 for every configuration: the build type does not change the generated game code.

set(ZOOSTERS_GAME_INCLUDE "${CMAKE_CURRENT_SOURCE_DIR}/src/game/include")
set(ZOOSTERS_FEATURES_H "${ZOOSTERS_GAME_INCLUDE}/zoosters/features.h")
set(ZOOSTERS_MSVC_MATH_H "${ZOOSTERS_GAME_INCLUDE}/zoosters/msvc_math.h")
set(ZOOSTERS_POSIX_COMPAT "${CMAKE_CURRENT_SOURCE_DIR}/src/port/compat/posix")
set(ZOOSTERS_PORT_CC_H "${CMAKE_CURRENT_SOURCE_DIR}/src/port/compat/port_cc.h")

foreach(lang C CXX)
  foreach(cfg DEBUG RELEASE RELWITHDEBINFO MINSIZEREL)
    set(CMAKE_${lang}_FLAGS_${cfg} "")
  endforeach()
endforeach()
set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded")
set(CMAKE_MSVC_DEBUG_INFORMATION_FORMAT "")

if(CMAKE_SIZEOF_VOID_P EQUAL 4)
  set(ZOOSTERS_ARCH x86)
elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64|ARM64)$")
  set(ZOOSTERS_ARCH arm64)
else()
  set(ZOOSTERS_ARCH x64)
endif()

if(MSVC AND NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
  set(ZOOSTERS_MSVC ON)
else()
  set(ZOOSTERS_MSVC OFF)
  if(NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang")
    message(FATAL_ERROR "Zoosters builds with MSVC or clang (the game code needs -fdeclspec / -fms-extensions)")
  endif()
endif()

function(_zoosters_force_include target file)
  if(ZOOSTERS_MSVC)
    target_compile_options(${target} PRIVATE "/FI${file}")
  else()
    target_compile_options(${target} PRIVATE "SHELL:-include \"${file}\"")
  endif()
endfunction()

# Flags of every source (also ImGui).
function(zoosters_base_flags target)
  target_compile_definitions(${target} PRIVATE NDEBUG WIN32 _WINDOWS WIN32_LEAN_AND_MEAN)
  if(ZOOSTERS_MSVC)
    target_compile_options(${target} PRIVATE /O2 /EHsc $<$<COMPILE_LANGUAGE:CXX>:/std:c++17> /permissive- /W0 /GR /Zc:threadSafeInit-)
  else()
    if(APPLE AND (NOT CMAKE_OSX_ARCHITECTURES OR CMAKE_OSX_ARCHITECTURES STREQUAL "arm64"))
      target_compile_options(${target} PRIVATE --target=arm64-apple-macos13)
    endif()
    target_compile_options(${target} PRIVATE -O2 -w -ffunction-sections $<$<COMPILE_LANGUAGE:CXX>:-std=c++17>
      -fno-strict-aliasing -fwrapv -fno-delete-null-pointer-checks)
    if(ZOOSTERS_ARCH STREQUAL "x86")
      target_compile_options(${target} PRIVATE -msse2 -mfpmath=sse)
    endif()
    if(NOT WIN32)
      target_compile_options(${target} PRIVATE -ffp-contract=off -fsigned-char -fdeclspec -fms-extensions)
      target_include_directories(${target} PRIVATE "${ZOOSTERS_POSIX_COMPAT}")
      _zoosters_force_include(${target} "${ZOOSTERS_POSIX_COMPAT}/msvc_crt.h")
    endif()
    target_compile_options(${target} PRIVATE -fno-threadsafe-statics)
  endif()
endfunction()

function(_zoosters_os_flags target)
  if(ZOOSTERS_OS_POISON)
    target_include_directories(${target} BEFORE PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/src/dev/poison")
  endif()
  if(ZOOSTERS_OS STREQUAL "sdl")
    target_compile_definitions(${target} PRIVATE ZOOSTERS_OS_SDL)
  endif()
endfunction()

function(_zoosters_tier_flags target)
  target_compile_definitions(${target} PRIVATE ZOOSTERS_TIER=${ZOOSTERS_TIER_INDEX})
  _zoosters_force_include(${target} "${ZOOSTERS_FEATURES_H}")
endfunction()

# src/game and src/data.
function(zoosters_game_flags target)
  zoosters_base_flags(${target})
  _zoosters_os_flags(${target})
  if(ZOOSTERS_DEBUGUI)
    target_compile_definitions(${target} PRIVATE ZOOSTERS_DEBUGUI)
  endif()
  if(ZOOSTERS_BINK AND ZOOSTERS_BINK_LOGOS)
    target_compile_definitions(${target} PRIVATE ZOOSTERS_BINK_LOGOS)
  endif()
  _zoosters_tier_flags(${target})
  if(NOT ZOOSTERS_MSVC)
    # the game's unsuffixed math calls are the double ones, as with MSVC's <math.h> (libc++ adds float overloads)
    _zoosters_force_include(${target} "${ZOOSTERS_MSVC_MATH_H}")
  endif()
  target_include_directories(${target} PRIVATE "${ZOOSTERS_GAME_INCLUDE}" "${CMAKE_CURRENT_SOURCE_DIR}/src/game")
endfunction()

# The call-trace build: src/game instrumented and not inlined, so x86 and x64 call the same functions.
function(zoosters_calltrace_flags target game_dir)
  if(ZOOSTERS_MSVC)
    target_compile_options(${target} PRIVATE /Gh /GH /Z7)
  else()
    target_compile_options(${target} PRIVATE -finstrument-functions)
  endif()
  # ctfbmodel.cpp keeps inlining: x64 faults in CTFBModel::ResolveSurfaceEffects without it
  set_source_files_properties("${game_dir}/modules/tfb/ctfbmodel.cpp" TARGET_DIRECTORY ${target} PROPERTIES COMPILE_OPTIONS "$<IF:$<BOOL:${ZOOSTERS_MSVC}>,/Ob2,>")
  get_target_property(srcs ${target} SOURCES)
  foreach(s ${srcs})
    if(NOT s STREQUAL "${game_dir}/modules/tfb/ctfbmodel.cpp")
      set_source_files_properties("${s}" TARGET_DIRECTORY ${target} PROPERTIES COMPILE_OPTIONS "$<IF:$<BOOL:${ZOOSTERS_MSVC}>,/Ob0,-fno-inline>")
    endif()
  endforeach()
endfunction()

# The port (src/port, src/dev) and librw.
function(zoosters_port_flags target)
  zoosters_base_flags(${target})
  _zoosters_os_flags(${target})
  if(ZOOSTERS_CALLTRACE)
    target_compile_definitions(${target} PRIVATE PORT_CALLTRACE_BUILD)
  endif()
  target_compile_definitions(${target} PRIVATE LODEPNG_NO_COMPILE_CPP PORT_NO_MAIN)
  _zoosters_force_include(${target} "${ZOOSTERS_PORT_CC_H}")
  target_include_directories(${target} PRIVATE "${ZOOSTERS_LIBRW_DIR}" "${ZOOSTERS_LIBRW_DIR}/src"
    "${ZOOSTERS_GAME_INCLUDE}" "${CMAKE_CURRENT_SOURCE_DIR}/src/game")
  if(ZOOSTERS_DEBUGUI)
    target_compile_definitions(${target} PRIVATE ZOOSTERS_DEBUGUI)
    target_include_directories(${target} PRIVATE "${ZOOSTERS_IMGUI_DIR}")
  endif()
  _zoosters_tier_flags(${target})
  if(ZOOSTERS_WINDOW STREQUAL "sdl")
    target_compile_definitions(${target} PRIVATE PORT_WINDOW_SDL)
  endif()
  if(ZOOSTERS_NEEDS_SDL3)
    target_link_libraries(${target} PRIVATE SDL3::SDL3)
  endif()
  if(ZOOSTERS_PLATFORM STREQUAL "gl3")
    # librw's OpenGL 3 backend on SDL3 (GL context on the SDL window, glad loader through SDL_GL_GetProcAddress)
    target_compile_definitions(${target} PRIVATE RW_GL3 LIBRW_SDL3)
  elseif(ZOOSTERS_PLATFORM STREQUAL "d3d9")
    target_compile_definitions(${target} PRIVATE RW_D3D9)
    if(ZOOSTERS_DXSDK_DIR)
      target_include_directories(${target} PRIVATE "${ZOOSTERS_DXSDK_DIR}/include")
    endif()
  else()
    target_compile_definitions(${target} PRIVATE RW_NULL)
  endif()
endfunction()

function(zoosters_link target)
  if(ZOOSTERS_NEEDS_SDL3)
    target_link_libraries(${target} PRIVATE SDL3::SDL3)
  endif()
  if(WIN32)
    target_link_libraries(${target} PRIVATE kernel32 user32 gdi32 winmm advapi32 shell32 ole32)
    if(ZOOSTERS_PLATFORM STREQUAL "d3d9")
      if(ZOOSTERS_DXSDK_DIR)
        target_link_libraries(${target} PRIVATE "${ZOOSTERS_DXSDK_DIR}/lib/${ZOOSTERS_ARCH}/d3d9.lib")
      else()
        target_link_libraries(${target} PRIVATE d3d9)
      endif()
    endif()
    if(ZOOSTERS_MSVC)
      target_link_options(${target} PRIVATE /SUBSYSTEM:CONSOLE)
      if(ZOOSTERS_DEV_HARNESS)
        target_link_options(${target} PRIVATE "/MAP:$<TARGET_FILE_DIR:${target}>/$<TARGET_FILE_BASE_NAME:${target}>.map")
      endif()
      if(ZOOSTERS_CALLTRACE)
        target_link_options(${target} PRIVATE /DEBUG /INCREMENTAL:NO /OPT:REF /OPT:NOICF)
      endif()
    endif()
  else()
    if(APPLE AND (NOT CMAKE_OSX_ARCHITECTURES OR CMAKE_OSX_ARCHITECTURES STREQUAL "arm64"))
      target_link_options(${target} PRIVATE --target=arm64-apple-macos13)
    endif()
    if(NOT APPLE)
      find_package(Threads REQUIRED)
      target_link_libraries(${target} PRIVATE Threads::Threads ${CMAKE_DL_LIBS})
    endif()
    if(ZOOSTERS_DEV_HARNESS)
      # the link map: the development tools rebuild the game-address table (<exe>.gaddr.tsv) from it
      if(APPLE)
        target_link_options(${target} PRIVATE "LINKER:-map,$<TARGET_FILE:${target}>.map")
      else()
        target_link_options(${target} PRIVATE "LINKER:-Map=$<TARGET_FILE:${target}>.map")
      endif()
    endif()
  endif()
endfunction()
