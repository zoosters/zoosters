{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "macos-arm64",
      "displayName": "macOS (Apple Silicon): Apple clang, OpenGL 3.3 on SDL3",
      "inherits": "base",
      "generator": "Ninja",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_PREFIX_PATH": "/opt/homebrew/opt/sdl3;/opt/homebrew/opt/openal-soft;/opt/homebrew"
      }
    },
    {
      "name": "linux-x64",
      "displayName": "Linux x86-64: clang, OpenGL 3.3 on SDL3",
      "inherits": "base",
      "generator": "Ninja",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": { "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++" }
    },
    {
      "name": "win-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "win-x86",
      "displayName": "Windows x86: MSVC, Direct3D 9",
      "inherits": "win-base",
      "architecture": { "value": "Win32", "strategy": "set" },
      "cacheVariables": { "ZOOSTERS_PLATFORM": "d3d9" }
    },
    {
      "name": "win-x64",
      "displayName": "Windows x64: MSVC, Direct3D 9",
      "inherits": "win-base",
      "architecture": { "value": "x64", "strategy": "set" },
      "cacheVariables": { "ZOOSTERS_PLATFORM": "d3d9" }
    },
    {
      "name": "win-x86-gl3",
      "displayName": "Windows x86: MSVC, OpenGL 3.3 on SDL3",
      "inherits": "win-base",
      "architecture": { "value": "Win32", "strategy": "set" },
      "cacheVariables": { "ZOOSTERS_PLATFORM": "gl3" }
    },
    {
      "name": "win-x64-gl3",
      "displayName": "Windows x64: MSVC, OpenGL 3.3 on SDL3",
      "inherits": "win-base",
      "architecture": { "value": "x64", "strategy": "set" },
      "cacheVariables": { "ZOOSTERS_PLATFORM": "gl3" }
    }
  ],
  "buildPresets": [
    { "name": "macos-arm64", "configurePreset": "macos-arm64" },
    { "name": "linux-x64", "configurePreset": "linux-x64" },
    { "name": "win-x86", "configurePreset": "win-x86", "configuration": "Release" },
    { "name": "win-x64", "configurePreset": "win-x64", "configuration": "Release" },
    { "name": "win-x86-gl3", "configurePreset": "win-x86-gl3", "configuration": "Release" },
    { "name": "win-x64-gl3", "configurePreset": "win-x64-gl3", "configuration": "Release" }
  ]
}
